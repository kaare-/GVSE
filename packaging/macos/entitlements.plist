<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Hardened Runtime entitlements for Developer ID + notarization.
  Not Mac App Store sandbox. Keep minimal; widen only if Gatekeeper rejects.
-->
<dict>
	<!-- Localhost IPC to wk-voxel-host / future saves. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- wgpu / Metal sometimes needs unsigned executable pages on older stacks. -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<!-- Disable if all dylibs are signed with the same identity. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
